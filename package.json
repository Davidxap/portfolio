{
  "name": "david-arroyave-portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:honesty": "node scripts/check/honesty.mjs",
    "check:eventloop": "node --experimental-strip-types scripts/check/eventloop.mjs",
    "check:contrast": "node scripts/check/contrast.mjs",
    "check": "npm run typecheck && npm test && npm run check:honesty -- out && npm run check:contrast && npm run check:eventloop"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
